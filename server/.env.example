# Copy to .env (local) or .env.prod (server) and fill in real values.
PORT=5000
NODE_ENV=development

# Signing key for JWTs. Use a long random string in anything but local dev —
# the app refuses to boot in production while this is still the placeholder.
#   openssl rand -hex 32
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Database — PostgreSQL. Hosted on Supabase; locally it can be any Postgres.
# The schema is created on startup, or via `npm run db:migrate`.
#
# Supabase's direct host (db.<ref>.supabase.co) is IPv6-only. From an IPv4-only
# host use the Supavisor pooler instead — Dashboard -> Connect -> Transaction
# pooler — which is dual-stack and uses postgres.<ref> as the username.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres

# TLS. DATABASE_CA_CERT points at the provider's CA so the server is verified,
# not merely encrypted — without it the connection is open to anyone who can
# answer for the database's address. Path is relative to server/.
#
# Supabase signs with a private root that is NOT in the system trust store, so
# this file is required for verification to work at all. Download it from
# Dashboard -> Project Settings -> Database -> SSL Configuration.
#
# Set DATABASE_SSL=false only for a plaintext Postgres on localhost. In
# production the app refuses to start without a CA unless you explicitly set
# DATABASE_SSL_INSECURE=true.
DATABASE_SSL=true
DATABASE_CA_CERT=certs/supabase-prod-ca-2021.crt

# Max pooled connections. Hosted free tiers allow far fewer than a dedicated
# instance, and a pooler counts every client — raise this only deliberately.
DATABASE_POOL_MAX=10

# Base used when building short links returned to the client. Must be an address
# the visitor's browser can reach, so on a remote box use its public IP or
# hostname (e.g. http://3.110.114.60:5000) — never localhost.
BASE_URL=http://localhost:5000

# Browser origin allowed to call this API. Same rule: match the address the
# browser actually loads the app from.
CORS_ORIGIN=http://localhost:5173

# Reverse proxies in front of the app. 0 when running it directly (dev),
# 1 when nginx sits in front of it (see deploy/setup.sh).
TRUST_PROXY=0
