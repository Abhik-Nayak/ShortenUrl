# Copy to .env and adjust.
PORT=5000
NODE_ENV=development

# Signing key for JWTs. Use a long random string in anything but local dev.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Where the JSON "database" file lives, relative to the server/ folder.
DATA_FILE=data/db.json

# Base used when building short links returned to the client.
BASE_URL=http://localhost:5000

# Browser origin allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Reverse proxies in front of the app. 0 when running it directly (dev),
# 1 when nginx sits in front of it (see deploy/setup.sh).
TRUST_PROXY=0
