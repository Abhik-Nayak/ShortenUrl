# Copy to .env and fill in real values. .env is git-ignored.

# HTTP server port
PORT=5000

# Public base URL used to build short links (no trailing slash)
BASE_URL=http://localhost:5000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shortenurl

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# JWT expiry (accepts values like 3600, "15m", "7d")
JWT_EXPIRES_IN=7d
