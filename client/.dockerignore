# Files Docker should NOT copy into the image.
# Paths are relative to the client/ folder (docker-compose says "build: ./client").

# The client Dockerfile uses "COPY . .", so without this line Docker would copy
# your Windows node_modules over the Linux ones it just installed, and the build
# would fail with strange errors.
node_modules

# Rebuilt inside the image by "npm run build".
dist

.env
.env.*
*.log
